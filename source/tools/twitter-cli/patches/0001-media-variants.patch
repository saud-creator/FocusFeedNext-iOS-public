     return media
+
+
+def _variant_size(url):
+    # type: (str) -> tuple
+    """Read `.../1280x720/...` out of a variant URL.
+
+    X encodes the rendition size in the path. Nothing is inferred when the
+    segment is absent: a guessed resolution on a quality menu is worse than no
+    label, because the reader would act on it.
+    """
+    for part in url.split("/"):
+        if "x" not in part:
+            continue
+        left, _, right = part.partition("x")
+        if left.isdigit() and right.isdigit():
+            return int(left), int(right)
+    return None, None

